{
  "name": "notes-category-campus-pro",
  "version": "5.6.0",
  "description": "Ultimate Glassmorphism Academic Notes & Timetable Manager for Campus Students (Windows 11 Compatible)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win nsis"
  },
  "keywords": [
    "campus",
    "university",
    "student",
    "notes",
    "timetable",
    "glassmorphism",
    "sri-lanka",
    "academic-hierarchy"
  ],
  "author": "Campus Student Pro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.campusstudent.notescategory",
    "productName": "Notes Category Campus Pro",
    "compression": "maximum",
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "main.js",
      "icon.png",
      "manifest.json",
      "sw.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
